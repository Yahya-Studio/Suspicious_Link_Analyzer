# ==============================================================================
# Environment Configuration Template (.env.example)
# Application: Suspicious Link Analyzer (محلل الروابط المشبوهة)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# IMPORTANT: Never commit the real .env file into version control!
# ==============================================================================

# VirusTotal API Key
# How to get your free API key:
# 1. Sign up for a free account at: https://www.virustotal.com/gui/join-us
# 2. Go to your profile menu (top right) -> API Key.
# 3. Copy your API Key and paste it below.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
